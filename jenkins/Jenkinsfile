pipeline {

    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    parameters {

        string(
            name: 'GIT_REPO',
            defaultValue: 'https://github.com/prathitagarje/devops-cicd-observability-platform.git',
            description: 'Git repository'
        )

        string(
            name: 'DOCKER_HUB_REPO',
            defaultValue: 'prathitagarje/basic-webapp',
            description: 'Docker Hub repository'
        )

        string(
            name: 'DOCKER_HUB_CREDENTIALS',
            defaultValue: 'dockerhub-credentials',
            description: 'Docker Hub Credentials ID'
        )
    }

    environment {

        IMAGE_TAG = "${BUILD_NUMBER}"

        IMAGE_NAME = "${params.DOCKER_HUB_REPO}:${BUILD_NUMBER}"

        LATEST_IMAGE = "${params.DOCKER_HUB_REPO}:latest"

        CONTAINER_NAME = "basic-webapp"
    }

    stages {

        stage('Checkout') {

            steps {

                echo 'Code already checked out by Jenkins'

                sh 'pwd'

                sh 'ls -R'
            }
        }

        stage('Build Image') {

            steps {

                echo "Building Docker image with DOCKER_HUB_REPO=${params.DOCKER_HUB_REPO}..."

                sh '''
                    if [[ "${DOCKER_HUB_REPO}" =~ ^https?:// ]]; then
                      echo "ERROR: DOCKER_HUB_REPO must be in the form username/repo, not a URL"
                      exit 1
                    fi

                    docker build \
                    -t ${IMAGE_NAME} \
                    -t ${LATEST_IMAGE} \
                    ./app
                '''
            }
        }

        stage('Test Container') {

            steps {

                echo 'Testing Docker container...'

                sh '''

                    docker rm -f test-container || true

                    docker run -d \
                      --name test-container \
                      -p 3001:3000 \
                      ${IMAGE_NAME}

                    sleep 10

                    curl -f http://localhost:3001/health

                    docker stop test-container

                    docker rm test-container
                '''
            }
        }

        stage('Push Image') {

            steps {

                echo 'Pushing image to DockerHub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: "${params.DOCKER_HUB_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''

                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin

                        docker push ${IMAGE_NAME}

                        docker push ${LATEST_IMAGE}
                    '''
                }
            }
        }

        stage('Deploy') {

            steps {

                echo 'Deploying container...'

                sh '''

                    docker stop ${CONTAINER_NAME} || true

                    docker rm ${CONTAINER_NAME} || true

                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p 3000:3000 \
                      --restart always \
                      ${LATEST_IMAGE}
                '''
            }
        }

        stage('Health Check') {

            steps {

                echo 'Performing health check...'

                sh '''

                    for i in {1..10}
                    do

                        if curl -f http://localhost:3000/health
                        then
                            echo "Application is healthy!"
                            exit 0
                        fi

                        echo "Waiting for application..."

                        sleep 5

                    done

                    echo "Health check failed!"

                    exit 1
                '''
            }
        }
    }

    post {

        always {

            echo 'Cleaning Docker resources...'

            sh 'docker system prune -f || true'
        }

        success {

            echo 'Pipeline executed successfully!'
        }

        failure {

            echo 'Pipeline execution failed!'
        }
    }
}
